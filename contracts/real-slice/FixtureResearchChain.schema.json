    "semantics_input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "real_grade": {
      "const": "UNSET_REQUIRED"
    },
    "invalidation": {
      "type": "object",
      "properties": {
        "status": {
          "const": "ACTIVE"
        },
        "parent_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
