        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "draft_ref": {
      "type": "object",
