              },
              "content_hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "object_id",
              "object_version",
              "content_hash"
            ],
            "additionalProperties": false
          },
          "minItems": 4
        },
        "valid_until": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "conditions": {
          "type": "array",
          "items": {
            "enum": [
              "UPSTREAM_HASH_OR_VERSION_CHANGED",
              "RECEIPT_REVOKED",
              "POLICY_REVOKED",
              "TTL_EXPIRED",
              "CARD_SUPERSEDED"
