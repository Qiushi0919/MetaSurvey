{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:real-slice:SourceAdmissionPolicy:2.0.0",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "SourceAdmissionPolicy"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "object_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "data_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "observation_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "terms_capture_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "terms_raw_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "entitlement_basis": {
      "const": "CAPTURED_SSE_WEBSITE_NONCOMMERCIAL_REFERENCE_ONLY"
    },
    "purpose": {
      "const": "LOCAL_CURRENT_OBSERVED_REFERENCE"
    },
    "namespace": {
      "const": "CORE_40"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "enum": [
              "SSE:603993",
              "SSE:600312",
              "SSE:603228"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "from": {
          "type": "string",
          "format": "date"
        },
        "to": {
          "type": "string",
          "format": "date"
        },
        "complete": {
          "type": "boolean"
        },
        "claim": {
          "enum": [
            "DOCUMENT_REFERENCES_ONLY",
            "FINITE_CALENDAR_REFERENCE",
            "COMPLETE_CURRENT_OBSERVED_DATA"
          ]
        }
      },
      "required": [
        "symbols",
        "from",
        "to",
        "complete",
        "claim"
      ],
      "additionalProperties": false
    },
    "clock_contract_version": {
      "const": "1.0.0"
    },
    "code_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "use_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "local_reference": {
          "const": true
        },
        "cloud_export": {
          "const": false
        },
        "raw_export": {
          "const": false
        },
        "redistribution": {
          "const": false
        },
        "historical_backtest": {
          "const": false
        },
        "production": {
          "const": false
        }
      },
      "required": [
        "local_reference",
        "cloud_export",
        "raw_export",
        "redistribution",
        "historical_backtest",
        "production"
      ],
      "additionalProperties": false
    },
    "projection": {
      "const": "REFERENCE_FACTS_ONLY"
    },
    "historical_visibility_proven": {
      "const": false
    },
    "production_enabled": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "source_id",
    "product",
    "data_type",
    "observation_ref",
    "terms_capture_hash",
    "terms_raw_sha256",
    "entitlement_basis",
    "purpose",
    "namespace",
    "coverage",
    "clock_contract_version",
    "code_epoch",
    "use_at",
    "permissions",
    "projection",
    "historical_visibility_proven",
    "production_enabled"
  ],
  "additionalProperties": false
}
