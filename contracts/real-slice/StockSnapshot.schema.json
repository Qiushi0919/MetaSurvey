{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:real-slice:StockSnapshot:1.0.0",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "StockSnapshot"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "object_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "enum": [
        "CURRENT_OBSERVED",
        "SYNTHETIC_TEST_ONLY"
      ]
    },
    "namespace": {
      "const": "CORE_40"
    },
    "purpose": {
      "const": "LOCAL_CURRENT_OBSERVED_REFERENCE"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "observation_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "object_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "object_id",
          "object_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "object_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "object_id",
          "object_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1
    },
    "fact_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "category_status": {
      "type": "object",
      "properties": {
        "SECURITY_STATUS": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "CALENDAR_RULES": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "RAW_BARS_1D": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "CORPORATE_ACTIONS": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "ADJUSTMENT_VERSIONS": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "FINANCIAL_REVISIONS": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "ANNOUNCEMENTS": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "INDUSTRY_MEMBERSHIP": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        }
      },
      "required": [
        "SECURITY_STATUS",
        "CALENDAR_RULES",
        "RAW_BARS_1D",
        "CORPORATE_ACTIONS",
        "ADJUSTMENT_VERSIONS",
        "FINANCIAL_REVISIONS",
        "ANNOUNCEMENTS",
        "INDUSTRY_MEMBERSHIP"
      ],
      "additionalProperties": false
    },
    "market_state": {
      "enum": [
        "CLOSED",
        "UNKNOWN",
        "OPEN"
      ]
    },
    "latest_trading_session": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "live_price": {
      "const": null
    },
    "trade_trigger": {
      "const": false
    },
    "tradeable": {
      "const": false
    },
    "historical_visibility_proven": {
      "const": false
    },
    "completion": {
      "enum": [
        "PARTIAL_RESEARCH_ONLY",
        "COMPLETE_LOCAL_REFERENCE_ONLY"
      ]
    },
    "production_enabled": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "scope",
    "namespace",
    "purpose",
    "decision_cutoff",
    "observation_refs",
    "policy_refs",
    "source_hashes",
    "fact_hashes",
    "data_hash",
    "category_status",
    "market_state",
    "latest_trading_session",
    "live_price",
    "trade_trigger",
    "tradeable",
    "historical_visibility_proven",
    "completion",
    "production_enabled"
  ],
  "additionalProperties": false
}
