{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metasurvey:sector-stock-v0:EvidenceBundle",
  "title": "EvidenceBundle",
  "type": "object",
  "properties": {
    "kind": {
      "const": "EvidenceBundle"
    },
    "contract_version": {
      "const": "0.1.0-candidate"
    },
    "experiment_id": {
      "const": "CORE40_SECTOR_STOCK_BASELINE_V0"
    },
    "namespace": {
      "const": "EXPERIMENT:CORE_40:SECTOR_STOCK_V0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "object_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "result_type": {
      "enum": [
        "SYNTHETIC",
        "CURRENT_OBSERVED_RESEARCH_ONLY"
      ]
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "productionGate": {
      "const": false
    },
    "native_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "ResearchCard",
              "BrainPacket"
            ]
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "object_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contract_version": {
            "const": "1.0.0"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "object_id",
          "object_version",
          "contract_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "raw_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "event_time": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "clock_basis": {
            "enum": [
              "SYNTHETIC_FIXTURE",
              "CURRENT_OBSERVATION_ONLY"
            ]
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,14})(\\.[0-9]{1,10})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "coding_record": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidence_id",
          "subject_id",
          "source",
          "source_version",
          "raw_hash",
          "revision_id",
          "locator",
          "event_time",
          "published_at",
          "available_at",
          "retrieved_at",
          "expires_at",
          "clock_basis",
          "metric",
          "value",
          "unit",
          "coding_record"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "historical_visibility_proven": {
      "const": false
    }
  },
  "required": [
    "kind",
    "contract_version",
    "experiment_id",
    "namespace",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "decision_cutoff",
    "result_type",
    "config_hash",
    "productionGate",
    "native_refs",
    "subject_id",
    "facts",
    "historical_visibility_proven"
  ],
  "additionalProperties": false
}
