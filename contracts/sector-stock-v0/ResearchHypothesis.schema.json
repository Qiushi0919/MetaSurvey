{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metasurvey:sector-stock-v0:ResearchHypothesis",
  "title": "ResearchHypothesis",
  "type": "object",
  "properties": {
    "kind": {
      "const": "ResearchHypothesis"
    },
    "contract_version": {
      "const": "0.1.0-candidate"
    },
    "experiment_id": {
      "const": "CORE40_SECTOR_STOCK_BASELINE_V0"
    },
    "namespace": {
      "const": "EXPERIMENT:CORE_40:SECTOR_STOCK_V0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "object_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "result_type": {
      "enum": [
        "SYNTHETIC",
        "CURRENT_OBSERVED_RESEARCH_ONLY"
      ]
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "productionGate": {
      "const": false
    },
    "native_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "ResearchCard",
              "BrainPacket"
            ]
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "object_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "contract_version": {
            "const": "1.0.0"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "object_id",
          "object_version",
          "contract_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "evidence_bundle_ref": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "object_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "contract_version",
    "experiment_id",
    "namespace",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "decision_cutoff",
    "result_type",
    "config_hash",
    "productionGate",
    "native_refs",
    "subject_id",
    "thesis",
    "counterevidence",
    "unknowns",
    "evidence_bundle_ref"
  ],
  "additionalProperties": false
}
