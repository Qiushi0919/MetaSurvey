  "field_rules": [
    {
      "wire": "content_hash",
      "normalized": "payload_hash (canonical contract-derived row) / snapshot_manifests.content_hash",
      "rule": "KEEP_DATASET_DATA_HASH_SEPARATE"
    },
    {
      "wire": "SnapshotManifest.data_hash",
      "normalized": "snapshot_manifests.data_hash / backtest_runs.data_hash",
      "rule": "HASH_OF_ORDERED_VISIBLE_DATA_NOT_MANIFEST_HASH"
    },
    {
      "wire": "provenance.publication_precision=SECOND",
      "normalized": "published_at_precision=SECOND",
      "rule": "PRESERVE_EXACT_OFFSET_INSTANT"
    },
    {
      "wire": "provenance.publication_precision=DATE_ONLY",
      "normalized": "published_at_precision=DAY",
      "rule": "NO_AUTOMATIC_MIDNIGHT_CONVERSION; verified trading calendar and source policy required before normalized projection"
    },
    {
      "wire": "provenance.publication_precision=UNKNOWN",
      "normalized": "NONE",
      "rule": "QUARANTINE_ONLY; no NOT_APPLICABLE laundering"
    },
    {
      "wire": "provenance.visibility_basis=OBSERVED_AT_TIME",
      "normalized": "OBSERVED_AS_OF",
      "rule": "AVAILABLE_AND_RETRIEVED_MUST_BOTH_PASS"
    },
    {
      "wire": "provenance.visibility_basis=HISTORICAL_AVAILABILITY_RECONSTRUCTION",
      "normalized": "PUBLIC_AS_OF",
      "rule": "EXPLICIT_RECONSTRUCTION_TAG_NOT_OBSERVED_FACT"
    },
    {
      "wire": "money cents string",
      "normalized": "money_cents NUMERIC",
      "rule": "BIND_DECIMAL_TEXT; never Number/coercion/rounding on ingress"
    },
    {
      "wire": "Approval.decision USER_*",
      "normalized": "approvals.decision USER_*",
      "rule": "LLM APPROVE STAYS brain_reviews ONLY"
    }
  ],
  "harness_interfaces": [
    {
      "module": "economics",
      "status": "PURE_FIXTURE_HARNESS_NOT_MODULE_API",
      "mapping": {
        "gross_notional_cents": "CostEstimate.notional_cents",
        "explicit_fees_cents": "CostEstimate.total_cost_cents",
        "version": "CostEstimate.cost_model_version"
      },
      "missing_binding": "Parent adapter must add account/strategy/security/profile/config/version/hash/trace; no P0 normalized adapter exists."
    },
    {
      "module": "ledger",
      "status": "PURE_FIXTURE_HARNESS_NOT_MODULE_API",
      "mapping": {
        "namespace": "strategy_id",
        "security_id": "SecurityIdentity lookup; no symbol guessing",
        "gross_notional_cents": "Fill.notional_cents",
        "execution_price_yuan": "Fill.price",
        "event_time": "Fill.executed_at"
      },
      "extra_required_context": [
        "trading_calendar",
        "execution_sequence",
        "lot_allocations",
        "opening_snapshot"
      ],
      "limitations": [
        "ONE_COMPLETE_FILL_PER_ORDER",
        "DEV_PAPER_ONLY",
        "NO_APPROVAL_OR_TRANSPORT"
      ]
    }
  ]
}
