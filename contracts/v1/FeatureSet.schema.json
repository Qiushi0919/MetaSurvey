{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:FeatureSet",
  "title": "FeatureSet",
  "description": "V1 P0 FeatureSet; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "FeatureSet"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "trade_date": {
      "type": "string",
      "format": "date"
    },
    "strategy_id": {
      "type": "string",
      "enum": [
        "CORE_40",
        "EVENT_3",
        "RESEARCH_6_18M"
      ]
    },
    "snapshot_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "feature_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
                "maxLength": 22,
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "CNY_PER_SHARE",
              "CNY",
              "SHARES",
              "BPS",
              "RATIO",
              "SCORE_0_TO_100"
            ]
          },
          "quality": {
            "type": "string",
            "enum": [
              "VALID",
              "MISSING",
              "INVALID"
            ]
          }
        },
        "required": [
          "value",
          "unit",
          "quality"
        ],
        "additionalProperties": false
      }
    },
    "data_quality": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "symbol",
    "trade_date",
    "strategy_id",
    "snapshot_ref",
    "decision_cutoff",
    "feature_version",
    "features",
    "data_quality"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "snapshot changed",
      "feature version changed",
      "DQ failed"
    ],
    "business_policy_defaults": false
  }
}
