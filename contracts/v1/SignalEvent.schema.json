{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:SignalEvent",
  "title": "SignalEvent",
  "description": "V1 P0 SignalEvent; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "SignalEvent"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Mode"
    },
    "account_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "strategy_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/TradeStrategy"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "card_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signal_type": {
      "type": "string",
      "enum": [
        "CORE_PULLBACK",
        "CORE_BREAKOUT",
        "EVENT_TRIGGER"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "WATCHING",
        "ARMED",
        "TRIGGERED",
        "ACKNOWLEDGED",
        "APPROVED",
        "EXECUTION_READY",
        "EXECUTED",
        "WAIT",
        "REJECTED",
        "EXPIRED",
        "INVALIDATED"
      ]
    },
    "market_data_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "triggered_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "symbol",
    "card_ref",
    "rule_version",
    "signal_type",
    "state",
    "market_data_at",
    "triggered_at",
    "expires_at",
    "dedupe_key"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "card/rule version changed",
      "stale data",
      "signal expired",
      "upstream invalidated"
    ],
    "business_policy_defaults": false
  }
}
