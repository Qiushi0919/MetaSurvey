{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:LedgerEntry",
  "title": "LedgerEntry",
  "description": "V1 P0 LedgerEntry; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "LedgerEntry"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Mode"
    },
    "account_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "strategy_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/TradeStrategy"
    },
    "currency": {
      "const": "CNY"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "FILL",
        "CASH_DIVIDEND",
        "DEPOSIT",
        "WITHDRAWAL"
      ]
    },
    "symbol": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "fill_ref": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "cash_delta_cents": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,37})$",
      "x-unit": "CNY_CENT_INTEGER_STRING"
    },
    "quantity_delta": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "account_cash_after_cents": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "x-unit": "CNY_CENT_INTEGER_STRING"
    },
    "position_quantity_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "effective_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_entry_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "currency",
    "entry_type",
    "symbol",
    "fill_ref",
    "cash_delta_cents",
    "quantity_delta",
    "account_cash_after_cents",
    "position_quantity_after",
    "effective_at",
    "sequence",
    "previous_entry_hash"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "duplicate entry/fill",
      "negative cash/quantity",
      "chain tampered",
      "cross-namespace ownership mismatch"
    ],
    "business_policy_defaults": false
  }
}
