{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:AuditEvent",
  "title": "AuditEvent",
  "description": "V1 P0 AuditEvent; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "AuditEvent"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "type": "string",
      "enum": [
        "DEV",
        "PAPER",
        "PROD"
      ]
    },
    "account_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "strategy_id": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "CORE_40",
            "EVENT_3",
            "RESEARCH_6_18M"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "HUMAN_USER",
        "SERVICE",
        "LLM"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "target_ref": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "before_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "after_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_event_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "model_review_is_authorization": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "actor_type",
    "actor_id",
    "action",
    "target_ref",
    "before_hash",
    "after_hash",
    "previous_event_hash",
    "occurred_at",
    "model_review_is_authorization"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "hash chain changed",
      "actor/authorization not authenticated"
    ],
    "business_policy_defaults": false
  }
}
