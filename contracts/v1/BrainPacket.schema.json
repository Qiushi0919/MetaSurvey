{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:BrainPacket",
  "title": "BrainPacket",
  "description": "V1 P0 BrainPacket; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "BrainPacket"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "request_type": {
      "type": "string",
      "enum": [
        "INITIAL_RESEARCH",
        "TRIGGER_REVIEW"
      ]
    },
    "strategy_id": {
      "type": "string",
      "enum": [
        "CORE_40",
        "EVENT_3",
        "RESEARCH_6_18M"
      ]
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "mode": {
      "type": "string",
      "enum": [
        "DEV",
        "PAPER",
        "PROD"
      ]
    },
    "snapshot_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:ashare:contracts:v1:DataEnvelope"
      }
    },
    "candidate_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
      }
    },
    "card_ref": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "signal_ref": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "transfer_mode": {
      "const": "MANUAL_EXPORT"
    },
    "model_review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "APPROVE",
                "WAIT",
                "REJECT"
              ]
            },
            "origin": {
              "const": "LLM"
            },
            "max_notional_cents": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,37})$",
                      "x-unit": "CNY_CENT_INTEGER_STRING"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "const": "UNSET_REQUIRED"
                }
              ]
            },
            "expires_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "reason_codes": {
              "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
            }
          },
          "required": [
            "decision",
            "origin",
            "max_notional_cents",
            "expires_at",
            "reason_codes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "contains_account_identity_or_credentials": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "request_type",
    "strategy_id",
    "account_id",
    "mode",
    "snapshot_ref",
    "decision_cutoff",
    "evidence",
    "candidate_refs",
    "card_ref",
    "signal_ref",
    "transfer_mode",
    "model_review",
    "contains_account_identity_or_credentials"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "snapshot/evidence altered",
      "review expired",
      "unbound card/signal"
    ],
    "business_policy_defaults": false
  }
}
