{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:ResearchCard",
  "title": "ResearchCard",
  "description": "V1 P0 ResearchCard; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "ResearchCard"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "type": "string",
      "enum": [
        "DEV",
        "PAPER",
        "PROD"
      ]
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "strategy_id": {
      "type": "string",
      "enum": [
        "CORE_40",
        "EVENT_3",
        "RESEARCH_6_18M"
      ]
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "snapshot_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "grade": {
      "type": "string",
      "enum": [
        "S",
        "A",
        "B",
        "C",
        "X",
        "UNSET_REQUIRED"
      ]
    },
    "research": {
      "type": "object",
      "properties": {
        "thesis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "strongest_counterevidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
          }
        },
        "horizon_months": {
          "type": "object",
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minimum",
            "maximum"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "thesis",
        "strongest_counterevidence",
        "unknowns",
        "evidence_refs",
        "horizon_months"
      ],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "reference_price": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$",
              "x-unit": "CNY_PER_SHARE"
            },
            {
              "type": "null"
            }
          ]
        },
        "entry_rules": {
          "type": "array",
          "items": {
            "$ref": "urn:ashare:contracts:v1:common#/$defs/Rule"
          }
        },
        "no_trade_rules": {
          "type": "array",
          "items": {
            "$ref": "urn:ashare:contracts:v1:common#/$defs/Rule"
          }
        }
      },
      "required": [
        "reference_price",
        "entry_rules",
        "no_trade_rules"
      ],
      "additionalProperties": false
    },
    "trade": {
      "type": "object",
      "properties": {
        "target_holding_sessions": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "maximum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "minimum",
                "maximum"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "invalidation_rules": {
          "type": "array",
          "items": {
            "$ref": "urn:ashare:contracts:v1:common#/$defs/Rule"
          }
        },
        "thesis_invalidation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "sizing_policy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "can_produce_order": {
          "type": "boolean"
        }
      },
      "required": [
        "target_holding_sessions",
        "invalidation_rules",
        "thesis_invalidation",
        "sizing_policy_version",
        "can_produce_order"
      ],
      "additionalProperties": false
    },
    "probability": {
      "type": "object",
      "properties": {
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "probability": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
                "maxLength": 22,
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              "return_bps": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
                "maxLength": 22,
                "x-unit": "EXACT_DECIMAL_STRING"
              }
            },
            "required": [
              "name",
              "probability",
              "return_bps"
            ],
            "additionalProperties": false
          }
        },
        "calibrated": {
          "type": "boolean"
        },
        "calibration_ref": {
          "anyOf": [
            {
              "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_mae_bps": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "EXACT_DECIMAL_STRING"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "net_edge_bps": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "EXACT_DECIMAL_STRING"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "edge_policy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        }
      },
      "required": [
        "scenarios",
        "calibrated",
        "calibration_ref",
        "expected_mae_bps",
        "net_edge_bps",
        "edge_policy_version"
      ],
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "properties": {
        "fundamental": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "sector": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "catalyst": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "trend": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "valuation": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "liquidity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "risk": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "research": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "quality": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "timing": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        },
        "final": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
              "maxLength": 22,
              "x-unit": "SCORE_0_TO_100"
            },
            {
              "const": "UNSET_REQUIRED"
            }
          ]
        }
      },
      "required": [
        "fundamental",
        "sector",
        "catalyst",
        "trend",
        "valuation",
        "liquidity",
        "evidence",
        "risk",
        "research",
        "quality",
        "timing",
        "raw",
        "final"
      ],
      "additionalProperties": false
    },
    "scoring_policy_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "const": "UNSET_REQUIRED"
        }
      ]
    },
    "hard_blocks": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "symbol",
    "snapshot_ref",
    "decision_cutoff",
    "grade",
    "research",
    "price",
    "trade",
    "probability",
    "scores",
    "scoring_policy_version",
    "hard_blocks",
    "rule_version"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "card superseded",
      "new hard negative",
      "thesis invalidated",
      "cost/sizing policy changed",
      "TTL expired"
    ],
    "business_policy_defaults": false
  }
}
