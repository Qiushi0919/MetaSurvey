{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:OrderIntent",
  "title": "OrderIntent",
  "description": "V1 P0 OrderIntent; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "OrderIntent"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Mode"
    },
    "account_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "strategy_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/TradeStrategy"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "order_type": {
      "const": "LIMIT"
    },
    "limit_price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$",
      "x-unit": "CNY_PER_SHARE"
    },
    "trade_date": {
      "type": "string",
      "format": "date"
    },
    "card_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "signal_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "decision_approval_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "final_confirmation_ref": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "account_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "client_order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "prepared_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PREPARED",
        "CONFIRMED",
        "SUBMITTED",
        "CANCELLED",
        "EXPIRED"
      ]
    },
    "production_execution_enabled": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "symbol",
    "side",
    "quantity",
    "order_type",
    "limit_price",
    "trade_date",
    "card_ref",
    "signal_ref",
    "decision_approval_ref",
    "final_confirmation_ref",
    "cost_ref",
    "account_snapshot_hash",
    "client_order_id",
    "prepared_at",
    "expires_at",
    "status",
    "production_execution_enabled"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "any bound version changed",
      "final terms changed",
      "duplicate client id",
      "account snapshot changed",
      "TTL expired"
    ],
    "business_policy_defaults": false
  }
}
