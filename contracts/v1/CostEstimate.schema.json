{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:CostEstimate",
  "title": "CostEstimate",
  "description": "V1 P0 CostEstimate; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "CostEstimate"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "mode": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Mode"
    },
    "account_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "strategy_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/TradeStrategy"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$",
      "x-unit": "CNY_PER_SHARE"
    },
    "notional_cents": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "x-unit": "CNY_CENT_INTEGER_STRING"
    },
    "fees": {
      "type": "object",
      "properties": {
        "commission_cents": {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/NonnegativeCents"
        },
        "exchange_cents": {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/NonnegativeCents"
        },
        "other_cents": {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/NonnegativeCents"
        },
        "stamp_cents": {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/NonnegativeCents"
        },
        "slippage_cents": {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/NonnegativeCents"
        }
      },
      "required": [
        "commission_cents",
        "exchange_cents",
        "other_cents",
        "stamp_cents",
        "slippage_cents"
      ],
      "additionalProperties": false
    },
    "total_cost_cents": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "x-unit": "CNY_CENT_INTEGER_STRING"
    },
    "round_trip_cost_bps": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,9})(\\.[0-9]{1,10})?$",
          "maxLength": 22,
          "x-unit": "EXACT_DECIMAL_STRING"
        },
        {
          "const": "UNSET_REQUIRED"
        }
      ]
    },
    "cost_model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "account_profile_ref": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
    },
    "cost_config_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "config_provenance": {
      "type": "string",
      "enum": [
        "SYNTHETIC_NOT_PRODUCTION",
        "LEGACY_EXPERIMENT",
        "BROKER_VERIFIED"
      ]
    },
    "slippage_treatment": {
      "type": "string",
      "enum": [
        "INCLUDED_IN_EXECUTION_PRICE",
        "SEPARATE_ESTIMATE"
      ]
    },
    "estimated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "mode",
    "account_id",
    "strategy_id",
    "symbol",
    "side",
    "quantity",
    "price",
    "notional_cents",
    "fees",
    "total_cost_cents",
    "round_trip_cost_bps",
    "cost_model_version",
    "account_profile_ref",
    "cost_config_hash",
    "config_provenance",
    "slippage_treatment",
    "estimated_at",
    "expires_at"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "quantity/price/config changed",
      "fee source unverified",
      "estimate expired"
    ],
    "business_policy_defaults": false
  }
}
