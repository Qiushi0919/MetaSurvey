{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:SecurityIdentity",
  "title": "SecurityIdentity",
  "description": "V1 P0 SecurityIdentity; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "SecurityIdentity"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "exchange": {
      "type": "string",
      "enum": [
        "SSE",
        "SZSE",
        "BSE",
        "UNSET_REQUIRED"
      ]
    },
    "security_code": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "board": {
      "type": "string",
      "enum": [
        "MAIN",
        "STAR",
        "CHINEXT",
        "BSE",
        "UNSET_REQUIRED"
      ]
    },
    "security_type": {
      "type": "string",
      "enum": [
        "STOCK",
        "ETF",
        "UNSET_REQUIRED"
      ]
    },
    "lot_size": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "const": "UNSET_REQUIRED"
        }
      ]
    },
    "tick_size": {
      "anyOf": [
        {
          "$ref": "urn:ashare:contracts:v1:common#/$defs/Price"
        },
        {
          "const": "UNSET_REQUIRED"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "DELISTED",
        "UNKNOWN"
      ]
    },
    "st_flag": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "UNSET_REQUIRED"
        }
      ]
    },
    "listed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "delisted_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "official_status_verified": {
      "type": "boolean"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "symbol",
    "exchange",
    "security_code",
    "name",
    "board",
    "security_type",
    "lot_size",
    "tick_size",
    "status",
    "st_flag",
    "listed_at",
    "delisted_at",
    "effective_from",
    "effective_to",
    "official_status_verified"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "status unknown",
      "effective interval ended",
      "source revision superseded"
    ],
    "business_policy_defaults": false
  }
}
