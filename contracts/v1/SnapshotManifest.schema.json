{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:v1:SnapshotManifest",
  "title": "SnapshotManifest",
  "description": "V1 P0 SnapshotManifest; structural engineering contract, no implicit production policy.",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "SnapshotManifest"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "object_version": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Version"
    },
    "trace_id": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Id"
    },
    "content_hash": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Hash"
    },
    "recorded_at": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Timestamp"
    },
    "business_timezone": {
      "const": "Asia/Shanghai"
    },
    "provenance": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Provenance"
    },
    "reason_codes": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/ReasonCodes"
    },
    "invalidation": {
      "$ref": "urn:ashare:contracts:v1:common#/$defs/Invalidation"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:ashare:contracts:v1:common#/$defs/Ref"
      }
    },
    "rules_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "SYNTHETIC",
        "LEGACY",
        "RECONSTRUCTED",
        "OBSERVED"
      ]
    },
    "excluded_metadata_exported": {
      "const": false
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "trace_id",
    "content_hash",
    "recorded_at",
    "business_timezone",
    "provenance",
    "reason_codes",
    "invalidation",
    "snapshot_id",
    "decision_cutoff",
    "data_hash",
    "evidence_refs",
    "rules_hash",
    "scope",
    "excluded_metadata_exported",
    "frozen_at"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "money": "canonical integer-cent string -> BigInt; Decimal prices/rates; no IEEE-754 money",
    "timezone": "offset required; business Asia/Shanghai, storage UTC",
    "hash": "SHA-256 of canonical JSON excluding only top-level content_hash",
    "required_optional": "required array is authoritative; nullable is required but explicitly unknown/not applicable",
    "reason_codes": "common ReasonCode enum; no arbitrary silent fallback",
    "invalidated_by": [
      "manifest changed",
      "freeze after reveal",
      "evidence beyond cutoff"
    ],
    "business_policy_defaults": false
  }
}
