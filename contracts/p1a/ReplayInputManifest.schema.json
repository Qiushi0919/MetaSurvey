{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:p1a:ReplayInputManifest",
  "title": "ReplayInputManifest",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "ReplayInputManifest"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "fixture_scope": {
      "const": "SYNTHETIC_EXPERIMENTAL"
    },
    "mode": {
      "const": "PAPER"
    },
    "production_enabled": {
      "const": false
    },
    "snapshot_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "feature_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "feature_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
