{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:p1a:DeterministicReplayResult",
  "title": "DeterministicReplayResult",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "DeterministicReplayResult"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "input": {
      "$ref": "urn:ashare:contracts:p1a:ReplayInputManifest"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 101
          },
          "entry_price": {
            "type": "string",
            "minLength": 1
          },
          "exit_price": {
            "type": "string",
            "minLength": 1
          },
          "incremental_expected_benefit_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "exit_reason": {
            "enum": [
              "THESIS_INVALIDATED",
              "RISK_INVALIDATED",
              "MATERIAL_EVENT",
              "PRICE_STRUCTURE_INVALIDATED"
            ]
          }
        },
        "required": [
          "id",
          "quantity",
          "entry_price",
          "exit_price",
          "incremental_expected_benefit_cents",
          "exit_reason"
        ],
        "additionalProperties": false
      }
    },
    "edge_enabled": {
      "type": "boolean"
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "const": false
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "REJECT_INSUFFICIENT_INCREMENTAL_EDGE",
                "REJECT_INSUFFICIENT_NET_EDGE",
                "REJECT_INSUFFICIENT_EDGE_COST_RATIO"
              ]
            }
          },
          "incremental_expected_benefit_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "incremental_transaction_cost_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "incremental_net_edge_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "edge_cost_ratio": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "const": "SYNTHETIC_EXPERIMENTAL"
          },
          "production_enabled": {
            "const": false
          }
        },
        "required": [
          "signal_id",
          "accepted",
          "reason_codes",
          "incremental_expected_benefit_cents",
          "incremental_transaction_cost_cents",
          "incremental_net_edge_cents",
          "edge_cost_ratio",
          "scope",
          "production_enabled"
        ],
        "additionalProperties": false
      }
    },
    "order_sequence": {
      "type": "array",
      "items": {
        "$ref": "urn:ashare:contracts:p1a:PaperReplayOrderIntent"
      }
    },
    "fill_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "fill_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PARTIALLY_FILLED",
              "FILLED"
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          },
          "price": {
            "type": "string",
            "minLength": 1
          },
          "trade_date": {
            "type": "string",
            "format": "date"
          },
          "cost_delta": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]{0,37})$"
            }
          },
          "cumulative_cost": {
            "$ref": "urn:ashare:contracts:p1a:P1ACostEstimate"
          },
          "settled_cash_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "reserved_cash_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "entry_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "order_id",
          "fill_id",
          "status",
          "quantity",
          "price",
          "trade_date",
          "cost_delta",
          "cumulative_cost",
          "settled_cash_cents",
          "reserved_cash_cents",
          "entry_hash"
        ],
        "additionalProperties": false
      }
    },
    "ledger_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract_name",
          "contract_version",
          "mode",
          "account_id",
          "sequence",
          "event_id",
          "event_time",
          "previous_hash",
          "entry_hash",
          "event",
          "cash_delta_cents",
          "reservation_delta_cents"
        ],
        "properties": {
          "contract_name": {},
          "contract_version": {},
          "mode": {},
          "account_id": {},
          "sequence": {},
          "event_id": {},
          "event_time": {},
          "previous_hash": {},
          "entry_hash": {},
          "event": {},
          "cash_delta_cents": {},
          "reservation_delta_cents": {}
        },
        "additionalProperties": true
      }
    },
    "daily_nav": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trade_date": {
            "type": "string",
            "format": "date"
          },
          "settled_cash_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "reserved_cash_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "position_value_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          },
          "nav_cents": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,37})$"
          }
        },
        "required": [
          "trade_date",
          "settled_cash_cents",
          "reserved_cash_cents",
          "position_value_cents",
          "nav_cents"
        ],
        "additionalProperties": false
      }
    },
    "cost_breakdown": {
      "$ref": "urn:ashare:contracts:p1a:CostAttribution"
    },
    "path_metrics": {
      "type": "array",
      "items": {
        "title": "PathMetrics",
        "type": "object",
        "properties": {
          "contract_name": {
            "const": "PathMetrics"
          },
          "contract_version": {
            "const": "1.0.0"
          },
          "entry_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$",
            "x-unit": "CNY_PER_SHARE"
          },
          "entry_date": {
            "type": "string",
            "format": "date"
          },
          "entry_timing": {
            "enum": [
              "SESSION_OPEN",
              "INTRADAY_UNKNOWN"
            ]
          },
          "mae_resolution": {
            "const": "DAILY_APPROXIMATION"
          },
          "mfe_resolution": {
            "const": "DAILY_APPROXIMATION"
          },
          "usage": {
            "const": "RETROSPECTIVE_OUTCOME_ONLY"
          },
          "horizon_basis": {
            "const": "TRADING_SESSIONS"
          },
          "sample_sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "window_status": {
            "type": "object",
            "properties": {
              "5D": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              },
              "10D": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              },
              "20D": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              },
              "40D": {
                "enum": [
                  "COMPLETE",
                  "INCOMPLETE"
                ]
              }
            },
            "required": [
              "5D",
              "10D",
              "20D",
              "40D"
            ],
            "additionalProperties": false
          },
          "MAE_5D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MAE_10D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MAE_20D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MFE_5D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MFE_10D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MFE_20D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "MFE_40D": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,10})?$",
                "x-unit": "EXACT_DECIMAL_STRING"
              },
              {
                "type": "null"
              }
            ]
          },
          "days_to_positive": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "days_to_MFE": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "drawdown_duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max_underwater_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration_resolution": {
            "const": "SESSION_CLOSE"
          },
          "positive_basis": {
            "const": "CLOSE_ABOVE_ENTRY_PRICE_EXCLUDING_FEES"
          },
          "censored": {
            "type": "boolean"
          },
          "path_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "signal_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "contract_name",
          "contract_version",
          "entry_price",
          "entry_date",
          "entry_timing",
          "mae_resolution",
          "mfe_resolution",
          "usage",
          "horizon_basis",
          "sample_sessions",
          "window_status",
          "MAE_5D",
          "MAE_10D",
          "MAE_20D",
          "MFE_5D",
          "MFE_10D",
          "MFE_20D",
          "MFE_40D",
          "days_to_positive",
          "days_to_MFE",
          "drawdown_duration",
          "max_underwater_days",
          "duration_resolution",
          "positive_basis",
          "censored",
          "path_hash",
          "signal_id"
        ],
        "additionalProperties": false,
        "x-contract": {
          "version": "1.0.0",
          "required_optional": "required array is authoritative; null means explicit unknown",
          "timezone": "Offset required, Asia/Shanghai business dates",
          "money": "BigInt integer cents; private Decimal100 HALF_UP; minimum commission effect is subset",
          "hash": "SHA256 canonical JSON; contract-specific projection in validator",
          "invalidated_by": [
            "input version/hash/time/policy change"
          ],
          "production_enabled": false
        }
      }
    },
    "trade_count": {
      "type": "integer",
      "minimum": 0
    },
    "round_trip_count": {
      "type": "integer",
      "minimum": 0
    },
    "ledger_chain_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "economic_result_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "wall_clock": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trace_id",
        "wall_clock"
      ],
      "additionalProperties": false
    },
    "production_enabled": {
      "const": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "input",
    "signals",
    "edge_enabled",
    "rejections",
    "order_sequence",
    "fill_sequence",
    "ledger_entries",
    "daily_nav",
    "cost_breakdown",
    "path_metrics",
    "trade_count",
    "round_trip_count",
    "ledger_chain_hash",
    "economic_result_hash",
    "diagnostics",
    "production_enabled"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "hash": "economic result canonical projection excludes only economic_result_hash, diagnostics and production_enabled; ledger excludes trace only",
    "money": "integer cents strings; min effect subset",
    "timezone": "offset timestamps; Asia/Shanghai dates",
    "invalidated_by": [
      "any bound input/fixture/code change"
    ],
    "production_enabled": false
  }
}
