{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:p1a:PaperSecurityProjection",
  "title": "PaperSecurityProjection",
  "type": "object",
  "properties": {
    "security_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "canonical_symbol": {
      "type": "string",
      "pattern": "^(SSE|SZSE):[0-9]{6}$"
    },
    "original_symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "lot_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "const": "ACTIVE"
    },
    "suspended": {
      "const": false
    },
    "tradeable": {
      "const": true
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "security_id",
    "canonical_symbol",
    "original_symbol",
    "lot_size",
    "status",
    "suspended",
    "tradeable",
    "version",
    "available_at",
    "content_hash"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "required_optional": "required array is authoritative; null means explicit unknown",
    "timezone": "Offset required, Asia/Shanghai business dates",
    "money": "BigInt integer cents; private Decimal100 HALF_UP; minimum commission effect is subset",
    "hash": "SHA256 canonical JSON; contract-specific projection in validator",
    "invalidated_by": [
      "input version/hash/time/policy change"
    ],
    "production_enabled": false
  }
}
