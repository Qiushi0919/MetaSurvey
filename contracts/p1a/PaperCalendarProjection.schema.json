{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:p1a:PaperCalendarProjection",
  "title": "PaperCalendarProjection",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "available_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "SYNTHETIC_FIXTURE",
            "OFFICIAL_CAPTURE"
          ]
        },
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "kind",
        "source_hash"
      ],
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "version",
    "sessions",
    "available_at",
    "source",
    "content_hash"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "required_optional": "required array is authoritative; null means explicit unknown",
    "timezone": "Offset required, Asia/Shanghai business dates",
    "money": "BigInt integer cents; private Decimal100 HALF_UP; minimum commission effect is subset",
    "hash": "SHA256 canonical JSON; contract-specific projection in validator",
    "invalidated_by": [
      "input version/hash/time/policy change"
    ],
    "production_enabled": false
  }
}
