{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:closure:SourceAdmissionPolicy",
  "title": "SourceAdmissionPolicy",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "SourceAdmissionPolicy"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "object_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fixture_scope": {
      "const": "SYNTHETIC_TEST_ONLY"
    },
    "purpose": {
      "const": "FIXTURE_MANUAL_EXPORT"
    },
    "mode": {
      "enum": [
        "DEV",
        "PAPER"
      ]
    },
    "production_enabled": {
      "const": false
    },
    "issuer": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "public_key_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "issuer_id",
        "key_id",
        "public_key_hash"
      ],
      "additionalProperties": false
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "source_class": {
            "const": "SYNTHETIC"
          },
          "license_type": {
            "const": "SYNTHETIC_TEST"
          },
          "terms_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "allowed_use": {
            "type": "array",
            "items": {
              "const": "SYNTHETIC_TEST"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "raw_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "source_id",
          "source_version",
          "source_hash",
          "source_class",
          "license_type",
          "terms_version",
          "allowed_use",
          "raw_hashes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exchanges": {
          "type": "array",
          "items": {
            "enum": [
              "SSE",
              "SZSE"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "from_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "object_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "SOURCE_OBSERVATION",
              "SECURITY",
              "STATUS",
              "CALENDAR",
              "BAR_1D",
              "CORPORATE_ACTION",
              "ADJUSTMENT",
              "FINANCIAL"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "symbols",
        "exchanges",
        "from_date",
        "to_date",
        "object_kinds"
      ],
      "additionalProperties": false
    },
    "freshness_seconds_by_kind": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "SOURCE_OBSERVATION",
          "SECURITY",
          "STATUS",
          "CALENDAR",
          "BAR_1D",
          "CORPORATE_ACTION",
          "ADJUSTMENT",
          "FINANCIAL"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "clock_basis": {
      "const": "SYNTHETIC_SOURCE_FIELD"
    },
    "allow_cloud_model_call": {
      "const": false
    },
    "allow_real_data": {
      "const": false
    },
    "allowed_projection": {
      "const": "FIXTURE_BAR_ENVELOPE_V1"
    },
    "version_chain_parent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "object_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "object_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "content_hash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "object_id",
            "object_version",
            "content_hash"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "content_hash",
    "fixture_scope",
    "purpose",
    "mode",
    "production_enabled",
    "issuer",
    "source_bindings",
    "coverage",
    "freshness_seconds_by_kind",
    "valid_from",
    "valid_until",
    "clock_basis",
    "allow_cloud_model_call",
    "allow_real_data",
    "allowed_projection",
    "version_chain_parent"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "scope": "approved fixture-only closure",
    "required_optional": "all listed properties required; explicit null only where allowed",
    "timezone": "offset required; business Asia/Shanghai; UTC storage",
    "money": "No floating money; referenced cost is exact Decimal/integer-cent strings",
    "hash": "canonical JSON SHA256 excludes top-level content_hash and proof; proof signs content_hash. Source policy has no proof.",
    "invalidation": [
      "source/raw/closure/policy/purpose/coverage/namespace/version/hash change",
      "receipt revocation/expiry",
      "unknown real input blocks"
    ],
    "no_production_defaults": true
  }
}
