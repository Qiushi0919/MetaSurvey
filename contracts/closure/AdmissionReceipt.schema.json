{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ashare:contracts:closure:AdmissionReceipt",
  "title": "AdmissionReceipt",
  "type": "object",
  "properties": {
    "contract_name": {
      "const": "AdmissionReceipt"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "object_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fixture_scope": {
      "const": "SYNTHETIC_TEST_ONLY"
    },
    "purpose": {
      "const": "FIXTURE_MANUAL_EXPORT"
    },
    "mode": {
      "enum": [
        "DEV",
        "PAPER"
      ]
    },
    "production_enabled": {
      "const": false
    },
    "verification": {
      "const": "VERIFIED"
    },
    "admission": {
      "const": "ADMITTED"
    },
    "strategy_id": {
      "enum": [
        "CORE_40",
        "EVENT_3",
        "RESEARCH_6_18M"
      ]
    },
    "policy_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "snapshot_ref": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "object_id",
        "object_version",
        "content_hash"
      ],
      "additionalProperties": false
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "closure_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "root_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "object_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "object_id",
          "object_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "closure_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "object_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "object_id",
          "object_version",
          "content_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decision_cutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exchanges": {
          "type": "array",
          "items": {
            "enum": [
              "SSE",
              "SZSE"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "from_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "object_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "SOURCE_OBSERVATION",
              "SECURITY",
              "STATUS",
              "CALENDAR",
              "BAR_1D",
              "CORPORATE_ACTION",
              "ADJUSTMENT",
              "FINANCIAL"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "symbols",
        "exchanges",
        "from_date",
        "to_date",
        "object_kinds"
      ],
      "additionalProperties": false
    },
    "feature_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "rules_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "issuer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "public_key_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "issuer_id",
        "key_id",
        "public_key_hash"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ED25519"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": [
        "algorithm",
        "signature"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_name",
    "contract_version",
    "object_id",
    "object_version",
    "content_hash",
    "fixture_scope",
    "purpose",
    "mode",
    "production_enabled",
    "verification",
    "admission",
    "strategy_id",
    "policy_ref",
    "snapshot_ref",
    "data_hash",
    "closure_hash",
    "root_refs",
    "closure_refs",
    "decision_cutoff",
    "coverage",
    "feature_version",
    "rules_hash",
    "issued_at",
    "expires_at",
    "issuer",
    "proof"
  ],
  "additionalProperties": false,
  "x-contract": {
    "version": "1.0.0",
    "scope": "approved fixture-only closure",
    "required_optional": "all listed properties required; explicit null only where allowed",
    "timezone": "offset required; business Asia/Shanghai; UTC storage",
    "money": "No floating money; referenced cost is exact Decimal/integer-cent strings",
    "hash": "canonical JSON SHA256 excludes top-level content_hash and proof; proof signs content_hash. Source policy has no proof.",
    "invalidation": [
      "source/raw/closure/policy/purpose/coverage/namespace/version/hash change",
      "receipt revocation/expiry",
      "unknown real input blocks"
    ],
    "no_production_defaults": true
  }
}
